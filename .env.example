# Supabase Configuration (Client & Server)
# Copy your Project URL and anon public key from Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_PUBLIC_KEY"
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_PUBLIC_KEY"

# Optional: Gemini AI API key for Ask Choy AI assistant
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional: App URL & Payment keys
APP_URL="https://your-app.onrender.com"
STRIPE_SECRET_KEY=""
PAYMAYA_SECRET_KEY=""

# Super Admin & Ops Admin Mobile + PIN Login (Server-Side Only - Never prefix with VITE_)
SUPER_ADMIN_MOBILE=
SUPER_ADMIN_PIN=
ADMIN_MOBILE=
ADMIN_PIN=

# Jollibee / Centro Partner Store Branch Login (Server-Side Only - Never prefix with VITE_)
STORE_JOLLIBEE_MOBILE=
STORE_JOLLIBEE_PIN=

