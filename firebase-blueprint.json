{
  "entities": {
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted Super Admin registry document keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 120
        },
        "grantedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "grantedBy", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public-safe user profile separated from private KYC PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "role": {
          "type": "string",
          "enum": ["customer", "rider", "store", "admin"]
        },
        "walletBalance": {
          "type": "number",
          "description": "Non-withdrawable Choy Wallet balance in PHP."
        },
        "choyProActive": {
          "type": "boolean"
        },
        "kycStatus": {
          "type": "string",
          "enum": ["unverified", "pending", "verified", "rejected"]
        },
        "riderCode": {
          "type": "string",
          "minLength": 0,
          "maxLength": 20
        },
        "storeName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "role", "walletBalance", "choyProActive", "kycStatus", "createdAt", "updatedAt"]
    },
    "KycVaultRecord": {
      "title": "KycVaultRecord",
      "description": "Strictly isolated private KYC record accessible only to the owning user and Super Admin.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "realLegalName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "phoneNumber": {
          "type": "string",
          "minLength": 7,
          "maxLength": 25
        },
        "otpVerified": {
          "type": "boolean"
        },
        "idType": {
          "type": "string",
          "enum": ["Drivers License", "UMID", "Passport", "PhilID"]
        },
        "idReference": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80
        },
        "profilePhotoName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "validIdPhotoName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "privacyConsentAccepted": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "verified", "rejected"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "realLegalName",
        "phoneNumber",
        "otpVerified",
        "idType",
        "idReference",
        "profilePhotoName",
        "validIdPhotoName",
        "privacyConsentAccepted",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "Dish": {
      "title": "Dish",
      "description": "Food catalog item published by a local partner store.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300
        },
        "price": {
          "type": "number"
        },
        "saleGroup": {
          "type": "string",
          "enum": ["Combo Meal", "Solo", "Extra", "Promo", "Good for Family"]
        },
        "storeName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "storeOwnerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "imageUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "likes": {
          "type": "integer"
        },
        "available": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "name",
        "description",
        "price",
        "saleGroup",
        "storeName",
        "storeOwnerId",
        "imageUrl",
        "likes",
        "available",
        "createdAt",
        "updatedAt"
      ]
    },
    "Order": {
      "title": "Order",
      "description": "7-step tracked food delivery order connecting Customer, Store, Rider, and Admin.",
      "type": "object",
      "properties": {
        "orderNumber": {
          "type": "string",
          "minLength": 4,
          "maxLength": 24,
          "pattern": "^CF-[0-9A-Z]+$"
        },
        "customerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerDisplayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "storeName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "storeOwnerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "riderId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        },
        "riderCode": {
          "type": "string",
          "minLength": 0,
          "maxLength": 20
        },
        "items": {
          "type": "array",
          "description": "Bounded list (1 to 25) of ordered item summaries."
        },
        "subtotal": {
          "type": "number"
        },
        "distanceTier": {
          "type": "string",
          "enum": ["0-2km", "2-5km", "5-10km"]
        },
        "deliveryFee": {
          "type": "number"
        },
        "discount": {
          "type": "number"
        },
        "totalAmount": {
          "type": "number"
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["COD", "GCash", "Card", "ChoyWallet"]
        },
        "deliveryAddress": {
          "type": "string",
          "minLength": 3,
          "maxLength": 240
        },
        "deliveryNote": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "step": {
          "type": "integer"
        },
        "status": {
          "type": "string",
          "enum": [
            "picked",
            "admin_checked",
            "store_accepted",
            "rider_accepted",
            "food_ready",
            "picked_up",
            "delivered",
            "cancelled"
          ]
        },
        "proofOfDeliveryNote": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "orderNumber",
        "customerId",
        "customerDisplayName",
        "storeName",
        "storeOwnerId",
        "riderId",
        "riderCode",
        "items",
        "subtotal",
        "distanceTier",
        "deliveryFee",
        "discount",
        "totalAmount",
        "paymentMethod",
        "deliveryAddress",
        "deliveryNote",
        "step",
        "status",
        "proofOfDeliveryNote",
        "createdAt",
        "updatedAt"
      ]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Customer, Rider, or Store support inquiry.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "contact": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "message": {
          "type": "string",
          "minLength": 5,
          "maxLength": 1000
        },
        "referenceCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 24,
          "pattern": "^CF-[0-9A-Z]+$"
        },
        "status": {
          "type": "string",
          "enum": ["open", "resolved"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "fullName",
        "contact",
        "category",
        "message",
        "referenceCode",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Super Admin system activity stream entry.",
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "minLength": 3,
          "maxLength": 240
        },
        "category": {
          "type": "string",
          "enum": ["order", "kyc", "store", "rider", "system"]
        },
        "actorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["message", "category", "actorId", "createdAt"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Trusted admin role registry."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public-safe user profile without PII."
    },
    "/kyc_vault/{userId}": {
      "schema": { "$ref": "#/entities/KycVaultRecord" },
      "description": "Encrypted Super Admin KYC Vault for private legal name, phone, and Valid ID records."
    },
    "/dishes/{dishId}": {
      "schema": { "$ref": "#/entities/Dish" },
      "description": "Partner store dishes and specialties."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "7-step food delivery orders."
    },
    "/support_tickets/{ticketId}": {
      "schema": { "$ref": "#/entities/SupportTicket" },
      "description": "Support inquiries from customers, stores, and riders."
    },
    "/activity_logs/{logId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "Audit and platform activity logs for Super Admin."
    }
  }
}
